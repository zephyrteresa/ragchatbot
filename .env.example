# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=

# Groq API Configuration (alternative to OpenAI)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=

# set here the vision model
VISION_MODEL=your_vision_model_here (ex: qwen/qwen3.8-27b)

# Embedding Configuration
# Optional: HuggingFace model for embeddings (default: sentence-transformers/all-MiniLM-L6-v2)
EMBEDDING_MODEL=

# Vector Database Configuration
# Optional: ChromaDB collection name 
CHROMA_COLLECTION_NAME=

#hugging face token
HF_TOKEN=